node_modules/
dist/*
!server-go/internal/static/dist/
server-go/internal/static/dist/*
!server-go/internal/static/dist/.gitkeep
drizzle/
.env
*.log
.DS_Store
server-go/migrate
server-go/seed
server-go/server
server-go/tmp/
.qwen/
docs/
!server-go/docs/
.kilo/
.vscode/

server-go/migrations/.applied/

# Auto-emitted tsc output (should not be checked in)
web/src/**/*.js
web/src/**/*.js.map
!web/src/**/*.config.js
# Local file uploads (avatars) in dev
server-go/uploads/
uploads/

# Private document storage (Phase 2 documents) — runtime files, never commit
server-go/data/

# Accidental go-jet generation from non-local DB
server-go/.gen/neondb/

# MarkItDown exports (generated markdown files)
markitdown-service/export-pdf/*
!markitdown-service/export-pdf/.gitkeep

# Local-only demo/dummy-data seeders — NEVER commit (they contain fake but
# PII-shaped data: names, NIK/NPWP, bank accounts). See server-go/cmd/seed/README.md.
server-go/cmd/seeddemo/
server-go/cmd/seedhris/
server-go/cmd/seedphase2/
server-go/cmd/seed-local*/

# Python bytecode cache
__pycache__/
*.pyc
